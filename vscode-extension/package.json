{
  "name": "dbml-diagrams",
  "displayName": "DBML Diagrams",
  "description": "Open DBML files as interactive database diagrams with the DBML Diagrams Rust parser.",
  "version": "0.1.4",
  "publisher": "Abidghods",
  "author": "Abid Ghods",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/abetss/offline-er-diagram.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "dbml",
    "database",
    "diagram",
    "schema"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCustomEditor:dbmlDiagrams.diagram"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "dbmlDiagrams.diagram",
        "displayName": "DBML Diagram",
        "selector": [
          {
            "filenamePattern": "*.[dD][bB][mM][lL]"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "dbmlDiagrams.openDiagram",
        "title": "DBML: Open diagram"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dbmlDiagrams.openDiagram",
          "when": "resourceExtname == .dbml",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "dbmlDiagrams.openDiagram",
          "when": "resourceExtname == .dbml",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "dbml",
        "aliases": [
          "DBML",
          "dbml"
        ],
        "extensions": [
          ".dbml",
          ".DBML"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dbml",
        "scopeName": "source.dbml",
        "path": "./syntaxes/dbml.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build:parser": "node scripts/build-parser.mjs",
    "build:webview": "npm --prefix ../frontend run build:vscode",
    "build:host": "tsc --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "build": "npm run build:parser && npm run build:webview && npm run build:host",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license --baseImagesUrl https://raw.githubusercontent.com/abetss/offline-er-diagram/main/vscode-extension --out ..",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
