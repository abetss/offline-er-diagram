{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBML Diagrams",
  "version": "0.1.0",
  "identifier": "ai.upliv.dbdiagrams",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev:tauri",
    "beforeBuildCommand": "npm --prefix frontend run build:tauri",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DBML Diagrams",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
